{
  "name": "dsh-plugin-infj-pet",
  "version": "1.0.3",
  "description": "INFJ Sage — a pixel-art Advocate/Counselor companion that lives in your DSH window and reflects what your agents are doing.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desktop-pet",
    "pixel-art",
    "sprite",
    "infj",
    "mbti",
    "companion"
  ],
  "packageManager": "pnpm@11.7.0",
  "icon": "./assets/icon.png",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "!lib/src",
    "assets",
    "!assets/sage.png.b64",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "PROVENANCE.md",
    "LICENSE",
    "ASSETS-LICENSE.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "check": "node tools/check.mjs",
    "test": "node --test tests/",
    "verify": "node tools/check.mjs && node --test tests/",
    "sage": "node tools/build-sage-index.mjs",
    "icons": "node tools/build-icons.mjs",
    "bundle": "node tools/build-bundle.mjs",
    "build": "node tools/build-sage-index.mjs && node tools/build-icons.mjs && node tools/build-bundle.mjs && node tools/build-preview.mjs",
    "preview": "node tools/build-preview.mjs",
    "prepublishOnly": "node tools/check.mjs && node --test tests/"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
